# What the Archipelago 0.6.8 worker image is built from. The file name is the base: the build
# fails if BASE_COMMIT reports a different Utils.__version__.
#
# BASE_COMMIT is a commit of https://github.com/ionium-ap/Archipelago.git, and the tag beside it
# names the same commit. Those tags never move. A new patch on the 0.6.8 line gets the next tag
# (0.6.8-ionium.2) and this pin moves to it.
#
# The 0.6.8 line is for generation only. It carries none of the fork's hosting patches.

# 0.6.8-ionium.1
BASE_COMMIT=2ae0d22870748b0502a539c926a933d4b6249931

# https://github.com/ionium-ap/Archipelago-fuzzer.git
# This commit cannot fuzz 0.6.8: Generate.main reads `args.allow_quantity` there and fuzz.py does
# not set it, so every run fails with an AttributeError. Move this pin once the fuzzer sets it.
# The workers don't use the fuzzer, only index CI does.
FUZZER_COMMIT=17227d793cc1088ae9be5fe97421e73bb683efdf

# https://github.com/ionium-ap/aplinter
LINTER_COMMIT=52cfa67f7e40ebe15bf6bff6d17adb6409ad97dc
